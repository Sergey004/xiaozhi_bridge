# ─── voice_api + xiaozhi_bridge .env ─────────────────────────────────────────

# ── Whisper STT ──────────────────────────────────────────────────────────────
WHISPER_MODEL=turbo           # tiny / base / small / medium / large / turbo
WHISPER_DEVICE=cuda           # cuda / cpu
WHISPER_COMPUTE_TYPE=float16  # float16 / int8 / float32
WHISPER_LANGUAGE=ru           # ru / en / None (auto)
WHISPER_BEAM_SIZE=5

# ── Chatterbox TTS ───────────────────────────────────────────────────────────
TTS_ENGINE=turbo              # turbo / multilingual / base
TTS_DEVICE=cuda
TTS_VOICE_SAMPLE=             # путь к .wav файлу для клонирования голоса (опционально)

# ── RVC (голос персонажа) ────────────────────────────────────────────────────
RVC_ENABLED=false             # true / false
RVC_MODEL_PATH=models/freddy.pth
RVC_INDEX_PATH=models/freddy.index
RVC_F0_METHOD=rmvpe           # rmvpe / crepe / harvest
RVC_PITCH_SHIFT=0             # полутоны: -12..+12
RVC_INDEX_RATE=0.5

# ── Стриминговый TTS+RVC (rvc_py.realtime.RVCStreamer) ───────────────────────
# chunk — RVC конвертирует речь блоками, звук уходит на устройство инкрементально
# sentence — батчевый TTS+RVC по предложениям; false — чистый батч
TTS_STREAMING=chunk
RVC_STREAM_BLOCK_MS=300       # размер RVC-блока @16kHz: меньше = ниже задержка, выше нагрузка GPU
RVC_STREAM_OVERLAP=1024       # контекст между блоками (сэмплы @16kHz)
RVC_STREAM_CROSSFADE=512      # зона crossfade/SOLA (сэмплы @16kHz)
RVC_STREAM_VAD_DB=-45         # гейт тишины (dB FS), none = выключить
RVC_STREAM_EXTRA_FRAME=0      # контекст слева для HuBERT/F0 @16кГц; 40000 (2.5s) —
                              # стабильнее голос на длинных фразах, дороже inference

# ── NVIDIA NIM LLM ───────────────────────────────────────────────────────────
NVIDIA_API_KEY=nvapi-...
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash
# Альтернативы:
# NVIDIA_MODEL=z-ai/glm-4.1v-thinking-flash
# NVIDIA_MODEL=deepseek-ai/deepseek-r1-0528

LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_MAX_TOKENS=512

# ── Ollama (альтернатива NIM) ─────────────────────────────────────────────────
LLM_PROVIDER=nvidia           # nvidia / ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# ── XiaoZhi Bridge ───────────────────────────────────────────────────────────
VOICE_API_URL=http://localhost:8000
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8765
