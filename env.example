# ─── xiaozhi_server.py (v2, всё-в-одном) ─────────────────────────────────────

# ── Whisper STT ──────────────────────────────────────────────────────────────
WHISPER_MODEL=turbo           # tiny / base / small / medium / large / turbo
WHISPER_DEVICE=cuda           # cuda / cpu
WHISPER_COMPUTE_TYPE=float16  # float16 / int8 / float32
WHISPER_LANGUAGE=ru           # ru / en / None (auto)
WHISPER_BEAM_SIZE=3

# ── VAD (серверный, AdaptiveVAD) ─────────────────────────────────────────────
VAD_SILENCE_FRAMES=25         # кадров тишины для конца речи (кадр 60мс)
VAD_MIN_RECORD_MS=600         # минимальная длина реплики
VAD_MAX_RECORD_MS=10000       # максимальная длина реплики
VAD_SPEECH_BOOST=1.5
VAD_MIN_PEAK_RAW=250          # энерго-гейт: пик сырых int16 в буфере (vqe_0 тихий)

# ── TTS (Chatterbox / DramaBox / edge / openai) ──────────────────────────────
TTS_ENGINE=turbo              # turbo / multilingual / base / dramabox / edge / openai
TTS_DEVICE=cuda
AUDIO_PROMPT_PATH=            # путь к .wav для клонирования голоса (опционально)

# ── RVC (голос персонажа) ────────────────────────────────────────────────────
RVC_ENABLED=false             # true / false
RVC_MODEL_PATH=models/freddy.pth
RVC_INDEX_PATH=models/freddy.index
RVC_F0_METHOD=rmvpe           # rmvpe / crepe / harvest
RVC_PITCH_SHIFT=0             # полутоны: -12..+12 (PitchAlign добавляет свой сдвиг)
RVC_INDEX_RATE=0.5
RVC_AUTO_PITCH_ALIGN=true     # выравнивание медианы f0 по референсу

# ── Стриминговый TTS+RVC (rvc_py.realtime.RVCStreamer) ───────────────────────
# chunk — RVC конвертирует речь блоками, звук уходит инкрементально (RVC нативно 40к → даунлинк)
# sentence — батчевый TTS+RVC по предложениям; batch — чистый батч
TTS_STREAMING=sentence
RVC_STREAM_BLOCK_MS=300       # размер RVC-блока @16kHz: меньше = ниже задержка, выше нагрузка GPU
RVC_STREAM_OVERLAP=1024       # контекст между блоками (сэмплы @16kHz)
RVC_STREAM_CROSSFADE=512      # зона crossfade/SOLA (сэмплы @16kHz)
RVC_STREAM_VAD_DB=-45         # гейт тишины (dB FS), none = выключить
RVC_STREAM_EXTRA_FRAME=0      # контекст слева для HuBERT/F0 @16кГц; 40000 (2.5s) —
                              # стабильнее голос на длинных фразах, дороже inference

# ── Даунлинк ──────────────────────────────────────────────────────────────────
# Opus поддерживает 8000/12000/16000/24000/48000. HD-клиенты (xiaozhi_linux_rs
# с features.downlink_hd=true) получают DOWNLINK_SR, остальные — 16к.
DOWNLINK_SR=48000

# ── LLM: цепочка провайдеров ─────────────────────────────────────────────────
# Основной (LLM_PROVIDER) + фоллбэки через запятую; при сбое rotate_llm().
LLM_PROVIDER=nvidia           # nvidia / zai / openrouter / ollama / openai_compatible
LLM_FALLBACK_PROVIDERS=nvidia
LLM_THINKING=off              # off = без reasoning-токенов (голосовой режим)
LLM_MODEL=glm-4.7-flash       # модель для zai/openai_compatible
LLM_BASE_URL=                 # для openai_compatible (пусто = default)
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_MAX_TOKENS=512

# NVIDIA NIM
NVIDIA_API_KEY=nvapi-...
NVIDIA_MODEL=z-ai/glm-5.3-flash

# Z.ai (GLM)
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# OpenRouter (бесплатные модели)
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=z-ai/glm-4.5-air:free

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# ── XiaoZhi протокол ─────────────────────────────────────────────────────────
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8765
HTTP_PORT=8000
BRIDGE_TOKEN=                 # общий токен (пусто = случайный при старте)
HMAC_SECRET=                  # секрет HMAC-токенов (пусто = BRIDGE_TOKEN)
TOKEN_EXPIRE_DAYS=30
ALLOWED_DEVICES=              # MAC через запятую; пусто = все разрешены
AUDIO_FORMAT=auto             # auto / opus / pcm

# ── Пайплайн ответа ──────────────────────────────────────────────────────────
LISTEN_MODE=auto              # auto / manual
MEMORY_ENABLED=true
MEMORY_MAX_ENTRIES=20
MEMORY_DIR=data/memory
TOOLS_ENABLED=true
TOOL_CALL_MODE=function_call  # function_call (intent_llm/nointent не реализованы)
END_PROMPT_ENABLED=true       # прощание после простоя
END_PROMPT_TIMEOUT=30         # секунд тишины до прощания
END_PROMPT_TEXT=See you later, superstar! Take care!
EXIT_COMMANDS=выход,выключись,exit,quit

# ── Музыка (tool play_music) ─────────────────────────────────────────────────
MUSIC_MODE=off                # off / url (прямые ссылки) / ytdlp (поиск через yt-dlp)
MUSIC_MAX_SECONDS=600         # предохранитель на стрим

# ── Напоминания (tool set_reminder) ──────────────────────────────────────────
REMINDER_CHECK_SEC=30
REMINDERS_FILE=data/reminders.json

# ── OTA / прочее ─────────────────────────────────────────────────────────────
OTA_VERSION=1.215
OTA_TIMEZONE=Europe/Moscow
OTA_FIRMWARE=                 # URL прошивки для /ota
EDGETTS_VOICE=ru-RU-SvetlanaNeural
